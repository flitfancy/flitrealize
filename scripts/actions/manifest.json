{
  "schemaVersion": 2,
  "providers": {
    "easyeda-pro": {
      "kind": "eda",
      "displayName": "EasyEDA Pro",
      "status": "tested"
    }
  },
  "workflows": {
    "easyeda-schematic-reflow": {
      "description": "按功能块重排原理图器件，或整体重排器件、短线和文字组合。",
      "discovery": {
        "keywords": [
          "原理图重排",
          "布局美化",
          "功能块重排",
          "reflow"
        ],
        "reference": "references/providers/easyeda-pro/2.2-schematic-workflow.md",
        "entrypoint": "scripts/schematic-reflow.mjs",
        "limitations": [
          "只处理原理图，不是 PCB 布局优化器。"
        ]
      },
      "domain": "schematic",
      "provider": "easyeda-pro",
      "phases": {
        "prepare": [{ "action": "schematic-reflow", "mode": "plan" }],
        "apply": [{ "action": "schematic-reflow", "mode": "apply" }],
        "verify": [{ "action": "schematic-reflow", "mode": "verify" }]
      }
    },
    "easyeda-schematic-components": {
      "description": "编排已确认器件的绑定、放置计划、分批写入、回读与保存，并核对中断批次。",
      "discovery": {
        "keywords": [
          "库存批量放件",
          "批量写入",
          "批量放置",
          "批量放件",
          "中断续放",
          "component placement"
        ],
        "reference": "references/providers/easyeda-pro/2.3-component-batch.md",
        "entrypoint": "scripts/schematic-components.mjs",
        "limitations": [
          "输入器件须先完成库存与身份确认；本流程不替代库存匹配或选料。",
          "使用封装脚本，不把 Workflow 名称传给 run --action；默认只计划，--apply 才写入。",
          "只放置和保存器件，不连线、不运行整图 DRC；未知写入无确定回执时停止，不强制续跑。",
          "封装脚本不自动删除或回滚；仅通过隔离模拟验证，真实 EDA 集成仍需代表批次验收。"
        ]
      },
      "domain": "schematic",
      "provider": "easyeda-pro",
      "phases": {
        "prepare": [
          { "action": "schematic-contract-audit", "mode": "inspect" },
          { "action": "schematic-resolve-bindings", "mode": "resolve" },
          { "action": "schematic-layout", "mode": "generate" },
          { "action": "schematic-component-place", "mode": "inspect" },
          { "action": "schematic-component-place", "mode": "plan" }
        ],
        "apply": [{ "action": "schematic-component-place", "mode": "apply" }],
        "verify": [{ "action": "schematic-component-place", "mode": "verify" }],
        "save": [
          { "action": "schematic-save-verify", "mode": "plan" },
          { "action": "schematic-save-verify", "mode": "apply" },
          { "action": "schematic-component-place", "mode": "inspect" }
        ]
      }
    },
    "easyeda-schematic-connect": {
      "description": "从 Contract 与现场派生端点短线、网络标识及 NC，检查已有连接，按配置重排、保存并执行严格 DRC。",
      "discovery": {
        "keywords": [
          "原理图连接",
          "连接收尾",
          "schematic connect",
          "原理图连线",
          "连接",
          "短线",
          "网络标签",
          "connect"
        ],
        "reference": "references/providers/easyeda-pro/2.4-schematic-connect.md",
        "entrypoint": "scripts/schematic-connect.mjs",
        "limitations": [
          "入口默认只计划；--apply 写入与收尾，--check 只读验证。",
          "自动创建限于 endpoint-stubs；长线、总线及层次连接沿用相应实现方法。",
          "NC 从 Contract 或有理由的显式物理引脚声明派生；不把所有悬空引脚自动设为 NC。",
          "重排需提供项目布局配置；未请求时保留现场布局并记录。"
        ]
      },
      "domain": "schematic",
      "provider": "easyeda-pro",
      "phases": {
        "prepare": [
          { "action": "schematic-inspect", "mode": "inspect" },
          { "action": "schematic-wire-plan", "mode": "generate" },
          { "action": "schematic-wire-create", "mode": "plan" },
          { "action": "schematic-net-flag", "mode": "plan" },
          { "action": "schematic-no-connect", "mode": "plan" }
        ],
        "apply": [
          { "action": "schematic-wire-create", "mode": "apply" },
          { "action": "schematic-net-flag", "mode": "apply" },
          { "action": "schematic-no-connect", "mode": "apply" }
        ],
        "verify": [
          { "action": "schematic-wire-create", "mode": "verify" },
          { "action": "schematic-net-flag", "mode": "verify" },
          { "action": "schematic-no-connect", "mode": "verify" },
          { "action": "schematic-inspect", "mode": "inspect" }
        ],
        "reflow": [
          { "action": "schematic-reflow", "mode": "plan", "optional": true },
          { "action": "schematic-reflow", "mode": "apply", "optional": true },
          { "action": "schematic-reflow", "mode": "verify", "optional": true }
        ],
        "finalize": [
          { "action": "schematic-save-verify", "mode": "plan" },
          { "action": "schematic-save-verify", "mode": "apply" },
          { "action": "schematic-inspect", "mode": "inspect" }
        ],
        "rollback": [
          { "action": "schematic-no-connect", "mode": "rollback", "optional": true },
          { "action": "schematic-net-flag", "mode": "rollback", "optional": true },
          { "action": "schematic-wire-create", "mode": "rollback" }
        ]
      }
    },
    "easyeda-schematic-finalize": {
      "description": "回读原理图、明确保存并运行当前配置的 DRC。",
      "discovery": {
        "keywords": [
          "原理图保存",
          "原理图检查",
          "DRC",
          "finalize"
        ],
        "reference": "references/providers/easyeda-pro/2.2-schematic-workflow.md"
      },
      "domain": "schematic",
      "provider": "easyeda-pro",
      "phases": {
        "prepare": [
          { "action": "schematic-inspect", "mode": "inspect" },
          { "action": "schematic-save-verify", "mode": "plan" }
        ],
        "apply": [{ "action": "schematic-save-verify", "mode": "apply" }],
        "verify": [{ "action": "schematic-save-verify", "mode": "verify" }]
      }
    }
  },
