{
  "schemaVersion": 2,
  "providers": {
    "easyeda-pro": {
      "kind": "eda",
      "displayName": "EasyEDA Pro",
      "status": "tested"
    }
  },
  "actions": {
    "eda-capabilities": {
      "file": "easyeda-pro/eda-capabilities.js",
      "description": "Read-only feature detection for the active EasyEDA document and API surface.",
      "contractVersion": 1,
      "domain": "system",
      "runtime": "eda",
      "providers": ["easyeda-pro"],
      "defaultMode": "inspect",
      "modes": {
        "inspect": { "mutates": false }
      },
      "requires": {
        "all": ["document.current"]
      }
    },
    "pcb-component-geometry": {
      "file": "easyeda-pro/pcb-component-geometry.js",
      "description": "Read exact component, pad, footprint-source, and bounding-box evidence.",
      "contractVersion": 1,
      "domain": "pcb",
      "runtime": "eda",
      "providers": ["easyeda-pro"],
      "defaultMode": "inspect",
      "modes": {
        "inspect": { "mutates": false }
      },
      "requires": {
        "all": ["document.current", "component.list", "pad.list", "file.documentSource", "file.footprintSources"]
      }
    },
    "pcb-functional-keepouts": {
      "file": "easyeda-pro/pcb-functional-keepouts.js",
      "description": "Inspect and transact bounded functional keepout Regions.",
      "contractVersion": 1,
      "domain": "pcb",
      "runtime": "eda",
      "providers": ["easyeda-pro"],
      "defaultMode": "inspect",
      "modes": {
        "inspect": { "mutates": false },
        "plan": { "mutates": false },
        "apply": { "mutates": true },
        "verify": { "mutates": false },
        "rollback": { "mutates": true }
      },
      "requires": {
        "all": ["document.current", "region.list", "math.polygon.create"],
        "apply": ["region.create"],
        "rollback": ["region.delete"]
      }
    },
    "pcb-ground-pours": {
      "file": "easyeda-pro/pcb-ground-pours.js",
      "description": "Inspect and transact realized copper pours against a resolved outline.",
      "contractVersion": 1,
      "domain": "pcb",
      "runtime": "eda",
      "providers": ["easyeda-pro"],
      "defaultMode": "inspect",
      "modes": {
        "inspect": { "mutates": false },
        "plan": { "mutates": false },
        "apply": { "mutates": true },
        "verify": { "mutates": false },
        "rollback": { "mutates": true }
      },
      "requires": {
        "all": ["document.current", "layer.list", "polyline.list", "pour.list", "poured.list", "math.polygon.create"],
        "apply": ["pour.create"],
        "rollback": ["pour.delete"]
      }
    },
    "pcb-ground-stitching": {
      "file": "easyeda-pro/pcb-ground-stitching.js",
      "description": "Read-only planner for bounded return-path and global GND stitching candidates.",
      "contractVersion": 1,
      "domain": "pcb",
      "runtime": "eda",
      "providers": ["easyeda-pro"],
      "defaultMode": "inspect",
      "modes": {
        "inspect": { "mutates": false },
        "generate": { "mutates": false }
      },
      "requires": {
        "all": ["document.current", "layer.list", "polyline.list", "region.list", "via.list", "pad.list", "line.list", "arc.list", "pour.list", "poured.list"]
      }
    },
    "pcb-ground-vias": {
      "file": "easyeda-pro/pcb-ground-vias.js",
      "description": "Inspect, generate, plan, apply, verify, and roll back bounded GND-via transactions.",
      "contractVersion": 1,
      "domain": "pcb",
      "runtime": "eda",
      "providers": ["easyeda-pro"],
      "defaultMode": "inspect",
      "modes": {
        "inspect": { "mutates": false },
        "generate": { "mutates": false },
        "plan": { "mutates": false },
        "apply": { "mutates": true },
        "verify": { "mutates": false },
        "rollback": { "mutates": true }
      },
      "requires": {
        "all": ["document.current", "via.list", "region.list", "component.list", "file.documentSource", "file.footprintSources"],
        "apply": ["via.create"],
        "rollback": ["via.delete"]
      }
    },
    "pcb-grounding-inspect": {
      "file": "easyeda-pro/pcb-grounding-inspect.js",
      "description": "Read-only grounding, copper, component, and keepout inventory.",
      "contractVersion": 1,
      "domain": "pcb",
      "runtime": "eda",
      "providers": ["easyeda-pro"],
      "defaultMode": "inspect",
      "modes": {
        "inspect": { "mutates": false }
      },
      "requires": {
        "all": ["document.current", "pour.list", "region.list", "via.list", "component.list", "file.documentSource", "file.footprintSources"]
      }
    },
    "pcb-layer-stack": {
      "file": "easyeda-pro/pcb-layer-stack.js",
      "description": "Inspect and transact the logical copper-layer structure.",
      "contractVersion": 1,
      "domain": "pcb",
      "runtime": "eda",
      "providers": ["easyeda-pro"],
      "defaultMode": "inspect",
      "modes": {
        "inspect": { "mutates": false },
        "plan": { "mutates": false },
        "apply": { "mutates": true },
        "verify": { "mutates": false },
        "rollback": { "mutates": true }
      },
      "requires": {
        "all": ["document.current", "layer.list"],
        "apply": ["layer.setCopperCount", "layer.modify"],
        "rollback": ["layer.setCopperCount", "layer.modify"]
      }
    },
    "schematic-contract-audit": {
      "file": "schematic-contract-audit.js",
      "description": "Audit SchematicContract v1 structure, references, evidence states, and provider boundaries locally.",
      "contractVersion": 1,
      "domain": "schematic",
      "runtime": "host",
      "providers": [],
      "defaultMode": "inspect",
      "modes": {
        "inspect": { "mutates": false }
      }
    },
    "schematic-layout": {
      "file": "schematic-layout.js",
      "description": "Calculate component positions from contract blocks and output a SchematicSnapshot with coordinates.",
      "contractVersion": 1,
      "domain": "schematic",
      "runtime": "host",
      "providers": [],
      "defaultMode": "inspect",
      "modes": {
        "inspect": { "mutates": false },
        "generate": { "mutates": false }
      }
    },
    "schematic-inspect": {
      "file": "easyeda-pro/schematic-inspect.js",
      "description": "Read-only capture of schematic components, wires, nets, and document identity.",
      "contractVersion": 1,
      "domain": "schematic",
      "runtime": "eda",
      "providers": ["easyeda-pro"],
      "defaultMode": "inspect",
      "modes": {
        "inspect": { "mutates": false }
      },
      "requires": {
        "all": ["document.current", "sch.component.list", "sch.wire.list", "sch.net.listNames"]
      }
    },
    "schematic-component-place": {
      "file": "easyeda-pro/schematic-component-place.js",
      "description": "Inspect, plan, apply, verify, and roll back schematic component placement.",
      "contractVersion": 1,
      "domain": "schematic",
      "runtime": "eda",
      "providers": ["easyeda-pro"],
      "defaultMode": "inspect",
      "modes": {
        "inspect": { "mutates": false },
        "plan": { "mutates": false },
        "apply": { "mutates": true },
        "verify": { "mutates": false },
        "rollback": { "mutates": true }
      },
      "requires": {
        "all": ["document.current", "sch.component.list", "sch.component.get"],
        "apply": ["sch.component.create"],
        "rollback": ["sch.component.delete"]
      }
    },
    "schematic-wire-create": {
      "file": "easyeda-pro/schematic-wire-create.js",
      "description": "Inspect, plan, apply, verify, and roll back schematic wire creation.",
      "contractVersion": 1,
      "domain": "schematic",
      "runtime": "eda",
      "providers": ["easyeda-pro"],
      "defaultMode": "inspect",
      "modes": {
        "inspect": { "mutates": false },
        "plan": { "mutates": false },
        "apply": { "mutates": true },
        "verify": { "mutates": false },
        "rollback": { "mutates": true }
      },
      "requires": {
        "all": ["document.current", "sch.wire.list", "sch.wire.get"],
        "apply": ["sch.wire.create"],
        "rollback": ["sch.wire.delete"]
      }
    },
    "schematic-net-flag": {
      "file": "easyeda-pro/schematic-net-flag.js",
      "description": "Apply, verify, and roll back schematic net flags and net ports.",
      "contractVersion": 1,
      "domain": "schematic",
      "runtime": "eda",
      "providers": ["easyeda-pro"],
      "defaultMode": "inspect",
      "modes": {
        "inspect": { "mutates": false },
        "apply": { "mutates": true },
        "verify": { "mutates": false },
        "rollback": { "mutates": true }
      },
      "requires": {
        "all": ["document.current", "sch.component.list"],
        "apply": ["sch.component.createNetFlag", "sch.component.createNetPort"],
        "rollback": ["sch.component.delete"]
      }
    },
    "schematic-save-verify": {
      "file": "easyeda-pro/schematic-save-verify.js",
      "description": "Save the schematic and run DRC verification.",
      "contractVersion": 1,
      "domain": "schematic",
      "runtime": "eda",
      "providers": ["easyeda-pro"],
      "defaultMode": "inspect",
      "modes": {
        "inspect": { "mutates": false },
        "verify": { "mutates": false }
      },
      "requires": {
        "all": ["document.current", "sch.document.save", "sch.drc.check"]
      }
    }
  }
}
