{
  "schemaVersion": 2,
  "providers": {
    "easyeda-pro": {
      "kind": "eda",
      "displayName": "EasyEDA Pro",
      "status": "tested"
    }
  },
  "workflows": {
    "easyeda-schematic-components": {
      "description": "Resolve EasyEDA devices, calculate placement, and transact component creation.",
      "domain": "schematic",
      "provider": "easyeda-pro",
      "phases": {
        "prepare": [
          { "action": "schematic-resolve-bindings", "mode": "resolve" },
          { "action": "schematic-layout", "mode": "generate" },
          { "action": "schematic-component-place", "mode": "plan" }
        ],
        "apply": [{ "action": "schematic-component-place", "mode": "apply" }],
        "verify": [{ "action": "schematic-component-place", "mode": "verify" }],
        "rollback": [{ "action": "schematic-component-place", "mode": "rollback" }]
      }
    },
    "easyeda-schematic-connect": {
      "description": "Capture live pins, plan and create endpoint stubs, and transact requested net flags.",
      "domain": "schematic",
      "provider": "easyeda-pro",
      "phases": {
        "prepare": [
          { "action": "schematic-inspect", "mode": "inspect" },
          { "action": "schematic-wire-plan", "mode": "generate" },
          { "action": "schematic-wire-create", "mode": "plan" },
          { "action": "schematic-net-flag", "mode": "plan", "optional": true }
        ],
        "apply": [
          { "action": "schematic-wire-create", "mode": "apply" },
          { "action": "schematic-net-flag", "mode": "apply", "optional": true }
        ],
        "verify": [
          { "action": "schematic-wire-create", "mode": "verify" },
          { "action": "schematic-net-flag", "mode": "verify", "optional": true }
        ],
        "rollback": [
          { "action": "schematic-net-flag", "mode": "rollback", "optional": true },
          { "action": "schematic-wire-create", "mode": "rollback" }
        ]
      }
    },
    "easyeda-schematic-finalize": {
      "description": "Capture the final schematic, explicitly save it, and run schematic DRC.",
      "domain": "schematic",
      "provider": "easyeda-pro",
      "phases": {
        "prepare": [
          { "action": "schematic-inspect", "mode": "inspect" },
          { "action": "schematic-save-verify", "mode": "plan" }
        ],
        "apply": [{ "action": "schematic-save-verify", "mode": "apply" }],
        "verify": [{ "action": "schematic-save-verify", "mode": "verify" }]
      }
    }
  },
  "actions": {
    "eda-capabilities": {
      "file": "easyeda-pro/eda-capabilities.js",
      "description": "Read-only feature detection for the active EasyEDA document and API surface.",
      "contractVersion": 1,
      "domain": "system",
      "runtime": "eda",
      "providers": ["easyeda-pro"],
      "defaultMode": "inspect",
      "modes": {
        "inspect": { "mutates": false }
      },
      "requires": {
        "all": ["document.current"]
      }
    },
    "pcb-component-geometry": {
      "file": "easyeda-pro/pcb-component-geometry.js",
      "description": "Read exact component, pad, footprint-source, and bounding-box evidence.",
      "contractVersion": 1,
      "domain": "pcb",
      "runtime": "eda",
      "providers": ["easyeda-pro"],
      "defaultMode": "inspect",
      "modes": {
        "inspect": { "mutates": false }
      },
      "requires": {
        "all": ["document.current", "component.list", "pad.list", "file.documentSource", "file.footprintSources"]
      }
    },
    "pcb-functional-keepouts": {
      "file": "easyeda-pro/pcb-functional-keepouts.js",
      "description": "Inspect and transact bounded functional keepout Regions.",
      "contractVersion": 1,
      "domain": "pcb",
      "runtime": "eda",
      "providers": ["easyeda-pro"],
      "defaultMode": "inspect",
      "modes": {
        "inspect": { "mutates": false },
        "plan": { "mutates": false },
        "apply": { "mutates": true },
        "verify": { "mutates": false },
        "rollback": { "mutates": true }
      },
      "requires": {
        "all": ["document.current", "region.list", "math.polygon.create"],
        "apply": ["region.create"],
        "rollback": ["region.delete"]
      }
    },
    "pcb-ground-pours": {
      "file": "easyeda-pro/pcb-ground-pours.js",
      "description": "Inspect and transact realized copper pours against a resolved outline.",
      "contractVersion": 1,
      "domain": "pcb",
      "runtime": "eda",
      "providers": ["easyeda-pro"],
      "defaultMode": "inspect",
      "modes": {
        "inspect": { "mutates": false },
        "plan": { "mutates": false },
        "apply": { "mutates": true },
        "verify": { "mutates": false },
        "rollback": { "mutates": true }
      },
      "requires": {
        "all": ["document.current", "layer.list", "polyline.list", "pour.list", "poured.list", "math.polygon.create"],
        "apply": ["pour.create"],
        "rollback": ["pour.delete"]
      }
    },
    "pcb-ground-stitching": {
      "file": "easyeda-pro/pcb-ground-stitching.js",
      "description": "Read-only planner for bounded return-path and global GND stitching candidates.",
      "contractVersion": 1,
      "domain": "pcb",
      "runtime": "eda",
      "providers": ["easyeda-pro"],
      "defaultMode": "inspect",
      "modes": {
        "inspect": { "mutates": false },
        "generate": { "mutates": false }
      },
      "requires": {
        "all": ["document.current", "layer.list", "polyline.list", "region.list", "via.list", "pad.list", "line.list", "arc.list", "pour.list", "poured.list"]
      }
    },
    "pcb-ground-vias": {
      "file": "easyeda-pro/pcb-ground-vias.js",
      "description": "Inspect, generate, plan, apply, verify, and roll back bounded GND-via transactions.",
      "contractVersion": 1,
      "domain": "pcb",
      "runtime": "eda",
      "providers": ["easyeda-pro"],
      "defaultMode": "inspect",
      "modes": {
        "inspect": { "mutates": false },
        "generate": { "mutates": false },
        "plan": { "mutates": false },
        "apply": { "mutates": true },
        "verify": { "mutates": false },
        "rollback": { "mutates": true }
      },
      "requires": {
        "all": ["document.current", "via.list", "region.list", "component.list", "file.documentSource", "file.footprintSources"],
        "apply": ["via.create"],
        "rollback": ["via.delete"]
      }
    },
    "pcb-grounding-inspect": {
      "file": "easyeda-pro/pcb-grounding-inspect.js",
      "description": "Read-only grounding, copper, component, and keepout inventory.",
      "contractVersion": 1,
      "domain": "pcb",
      "runtime": "eda",
      "providers": ["easyeda-pro"],
      "defaultMode": "inspect",
      "modes": {
        "inspect": { "mutates": false }
      },
      "requires": {
        "all": ["document.current", "pour.list", "region.list", "via.list", "component.list", "file.documentSource", "file.footprintSources"]
      }
    },
    "pcb-layer-stack": {
      "file": "easyeda-pro/pcb-layer-stack.js",
      "description": "Inspect and transact the logical copper-layer structure.",
      "contractVersion": 1,
      "domain": "pcb",
      "runtime": "eda",
      "providers": ["easyeda-pro"],
      "defaultMode": "inspect",
      "modes": {
        "inspect": { "mutates": false },
        "plan": { "mutates": false },
        "apply": { "mutates": true },
        "verify": { "mutates": false },
        "rollback": { "mutates": true }
      },
      "requires": {
        "all": ["document.current", "layer.list"],
        "apply": ["layer.setCopperCount", "layer.modify"],
        "rollback": ["layer.setCopperCount", "layer.modify"]
      }
    },
    "schematic-contract-audit": {
      "file": "schematic-contract-audit.js",
      "description": "Audit SchematicContract v1 structure, references, evidence states, and provider boundaries locally.",
      "contractVersion": 1,
      "domain": "schematic",
      "runtime": "host",
      "providers": [],
      "defaultMode": "inspect",
      "modes": {
        "inspect": { "mutates": false }
      }
    },
    "schematic-layout": {
      "file": "schematic-layout.js",
      "description": "Calculate component positions from contract blocks and output a provider-bound SchematicPlacementPlan.",
      "contractVersion": 3,
      "internal": true,
      "domain": "schematic",
      "runtime": "host",
      "providers": [],
      "defaultMode": "inspect",
      "modes": {
        "inspect": { "mutates": false },
        "generate": { "mutates": false }
      }
    },
    "schematic-wire-plan": {
      "file": "schematic-wire-plan.js",
      "description": "Derive bounded orthogonal wire stubs from a contract and live SchematicSnapshot pin coordinates.",
      "contractVersion": 2,
      "internal": true,
      "domain": "schematic",
      "runtime": "host",
      "providers": [],
      "defaultMode": "inspect",
      "modes": {
        "inspect": { "mutates": false },
        "generate": { "mutates": false }
      }
    },
    "schematic-inspect": {
      "file": "easyeda-pro/schematic-inspect.js",
      "description": "Capture a live SchematicSnapshot including component, pin-coordinate, wire, net, and document evidence.",
      "contractVersion": 2,
      "internal": true,
      "domain": "schematic",
      "runtime": "eda",
      "providers": ["easyeda-pro"],
      "defaultMode": "inspect",
      "modes": {
        "inspect": { "mutates": false }
      },
      "requires": {
        "all": ["document.current", "sch.component.list", "sch.component.getAllPins", "sch.wire.list", "sch.net.listNames"]
      }
    },
    "schematic-component-place": {
      "file": "easyeda-pro/schematic-component-place.js",
      "description": "Inspect, plan, apply, verify, and roll back schematic component placement.",
      "contractVersion": 3,
      "internal": true,
      "domain": "schematic",
      "runtime": "eda",
      "providers": ["easyeda-pro"],
      "defaultMode": "inspect",
      "modes": {
        "inspect": { "mutates": false },
        "plan": { "mutates": false },
        "apply": { "mutates": true },
        "verify": { "mutates": false },
        "rollback": { "mutates": true }
      },
      "requires": {
        "all": ["document.current", "sch.component.list", "sch.component.get"],
        "apply": ["sch.component.create", "sch.component.modify"],
        "rollback": ["sch.component.delete"]
      }
    },
    "schematic-resolve-bindings": {
      "file": "easyeda-pro/schematic-resolve-bindings.js",
      "description": "Resolve Contract components into an internal EasyEDA binding map using explicit or uniquely proven matches.",
      "contractVersion": 3,
      "internal": true,
      "domain": "schematic",
      "runtime": "eda",
      "providers": ["easyeda-pro"],
      "defaultMode": "inspect",
      "modes": {
        "inspect": { "mutates": false },
        "search": { "mutates": false },
        "resolve": { "mutates": false }
      },
      "requires": {
        "search": ["lib.device.search"]
      }
    },
    "schematic-wire-create": {
      "file": "easyeda-pro/schematic-wire-create.js",
      "description": "Inspect, plan, apply, verify, and roll back schematic wire creation.",
      "contractVersion": 2,
      "internal": true,
      "domain": "schematic",
      "runtime": "eda",
      "providers": ["easyeda-pro"],
      "defaultMode": "inspect",
      "modes": {
        "inspect": { "mutates": false },
        "plan": { "mutates": false },
        "apply": { "mutates": true },
        "verify": { "mutates": false },
        "rollback": { "mutates": true }
      },
      "requires": {
        "all": ["document.current", "sch.component.list", "sch.component.getAllPins", "sch.wire.list", "sch.wire.get"],
        "apply": ["sch.wire.create"],
        "rollback": ["sch.wire.delete"]
      }
    },
    "schematic-net-flag": {
      "file": "easyeda-pro/schematic-net-flag.js",
      "description": "Inspect, plan, apply, verify, and roll back schematic net flags and net ports.",
      "contractVersion": 2,
      "internal": true,
      "domain": "schematic",
      "runtime": "eda",
      "providers": ["easyeda-pro"],
      "defaultMode": "inspect",
      "modes": {
        "inspect": { "mutates": false },
        "plan": { "mutates": false },
        "apply": { "mutates": true },
        "verify": { "mutates": false },
        "rollback": { "mutates": true }
      },
      "requires": {
        "all": ["document.current", "sch.component.list"],
        "apply": ["sch.component.createNetFlag", "sch.component.createNetPort"],
        "rollback": ["sch.component.delete"]
      }
    },
    "schematic-save-verify": {
      "file": "easyeda-pro/schematic-save-verify.js",
      "description": "Plan and apply an explicit schematic save, or run read-only DRC verification.",
      "contractVersion": 2,
      "internal": true,
      "domain": "schematic",
      "runtime": "eda",
      "providers": ["easyeda-pro"],
      "defaultMode": "inspect",
      "modes": {
        "inspect": { "mutates": false },
        "plan": { "mutates": false },
        "apply": { "mutates": true },
        "verify": { "mutates": false }
      },
      "requires": {
        "all": ["document.current", "sch.component.list", "sch.wire.list"],
        "apply": ["sch.document.save", "sch.drc.check"],
        "verify": ["sch.drc.check"]
      }
    }
  }
}
